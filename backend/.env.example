# Local development only. Change secrets before any shared deployment.
APP_NAME=MulkAnaliz API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+pysqlite:///./data/real_estate_dev.db
SQL_ECHO=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
JWT_SECRET_KEY=development-only-secret-key-change-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURE_COOKIES=false
EXPOSE_API_DOCS=true
LOG_LEVEL=INFO
OFFICE_REGISTRATION_CODE=change-this-office-registration-code
